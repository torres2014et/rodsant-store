  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git add -A; git diff --cached --quiet; if ($LASTEXITCODE -ne 0) { git commit -m \"Auto: cambios de la sesion $(Get-Date -Format 'yyyy-MM-dd HH:mm')\" | Out-Null; git push origin main } else { Write-Output 'Sin cambios que subir.' }",
            "shell": "powershell",
            "timeout": 120,
            "statusMessage": "Guardando cambios en GitHub..."
          }
        ]
      }
